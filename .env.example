# Local development only. scripts/backend.ps1 -Task setup generates .env if absent.
POSTGRES_DB=tracepilot

POSTGRES_USER=tracepilot

POSTGRES_PASSWORD=replace-with-local-password

POSTGRES_PORT=15432

RABBITMQ_USER=tracepilot

RABBITMQ_PASSWORD=replace-with-local-password

RABBITMQ_PORT=5673

RABBITMQ_MANAGEMENT_PORT=15673

SERVER_PORT=8080

# Generate a random 64-character value; never commit the actual signing secret.
AUTH_SIGNING_SECRET=replace-with-random-64-character-secret

# Optional Phase 02 integration. Bind one installation to an operator-approved workspace.
GITHUB_ENABLED=false
GITHUB_APP_ID=0
GITHUB_INSTALLATION_ID=0
GITHUB_WORKSPACE_ID=
# Absolute path with forward slashes to an RSA PKCS#8 PEM file, outside Git.
GITHUB_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=

# Phase 03 workers follow GITHUB_ENABLED by default. Override to pause dispatch/consumption.
# PIPELINE_ENABLED=true

# Phase 05: explicitly opt in before sending redacted logs to OpenAI.
AI_ENABLED=false
AI_API_KEY=
AI_MODEL=
# Optional USD per million tokens; leave empty when pricing has not been verified.
AI_INPUT_PRICE_PER_MILLION=
AI_OUTPUT_PRICE_PER_MILLION=

# Phase 06: opt in to indexing/search and RAG; requires AI_ENABLED=true.
# Model/dimension are locked by V7: text-embedding-3-small / 1536.
RAG_ENABLED=false
EMBEDDING_PRICE_PER_MILLION=
