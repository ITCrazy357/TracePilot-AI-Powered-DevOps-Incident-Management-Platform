# Separate from .env; scripts/shipping.ps1 -Task init generates fresh local secrets.
POSTGRES_DB=tracepilot
POSTGRES_USER=tracepilot
POSTGRES_PASSWORD=replace-with-random-db-password
RABBITMQ_USER=tracepilot
RABBITMQ_PASSWORD=replace-with-random-broker-password
AUTH_SIGNING_SECRET=replace-with-random-64-character-secret
FRONTEND_PORT=13000
BACKEND_PORT=18081
APP_ORIGIN=http://127.0.0.1:13000

# Opt in only after configuring a GitHub App installation for an existing workspace.
GITHUB_ENABLED=false
GITHUB_APP_ID=0
GITHUB_INSTALLATION_ID=0
GITHUB_WORKSPACE_ID=
GITHUB_WEBHOOK_SECRET=
# Host file used only by compose.github.yaml; never copy a key into an image.
GITHUB_PRIVATE_KEY_FILE=

# Explicit consent before sending redacted logs to a paid provider.
AI_ENABLED=false
AI_API_KEY=
AI_MODEL=
RAG_ENABLED=false
AI_INPUT_PRICE_PER_MILLION=
AI_OUTPUT_PRICE_PER_MILLION=
EMBEDDING_PRICE_PER_MILLION=
